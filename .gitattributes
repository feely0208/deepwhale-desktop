# 统一行尾：源码/文档用 LF，二进制不转换
* text=auto

*.js  text eol=lf
*.ts  text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.plist text eol=lf
*.mjs text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.icns binary
*.ico binary

# ⚠️ 2026-10-17 事故：Windows runner 会把未显式声明 eol 的文本转成 CRLF，
# 而 build/installer.nsh 参与按行正则校验（scripts/check-installer-close-app.js），
# CRLF 让它连续红了三轮。所有会被脚本按行解析的文本都必须显式 eol=lf。
*.nsh   text eol=lf
*.etx  text eol=lf
*.sh    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.css   text eol=lf
*.txt   text eol=lf
