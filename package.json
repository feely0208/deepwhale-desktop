{
  "name": "deepwhale-desktop",
  "productName": "DeepWhale Desktop",
  "version": "1.0.62",
  "description": "深鲸桌面（DeepWhale Desktop）：把 DeepSeek Harness（DSH）Web UI 装进 Electron 原生窗口的跨平台桌面壳，附带背景皮肤、帧动画桌面宠物与用量/额度面板",
  "main": "dist/main/index.js",
  "author": "温州深鲸智能科技有限公司 <contact@deepwhale.org.cn>",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "electron",
    "desktop",
    "dsh"
  ],
  "scripts": {
    "build": "node scripts/dsh-runtime-version.js --generate && tsc && node scripts/copy-assets.js",
    "dev": "npm run build && electron .",
    "smoke": "npm run build && DSH_DESKTOP_SMOKE=1 electron .",
    "smoke:win": "npm run build && set DSH_DESKTOP_SMOKE=1&& electron .",
    "test:inject": "npm run build && node scripts/test-inject-race.js",
    "test:migrate": "node scripts/test-migrate-attachments.js",
    "test:mac-gate": "node scripts/test-mac-update-gate.js",
    "test:profile": "node scripts/test-profile.js",
    "test:update-feed": "node scripts/test-update-feed.js",
    "test:mobile-urls": "node scripts/test-mobile-urls.js",
    "test:mobile-relay": "node scripts/test-mobile-relay.js",
    "check:mobile-attach": "node scripts/check-mobile-attachments.mjs",
    "check:mobile-features": "node scripts/check-mobile-features-e2e.mjs",
    "check:packaged-mobile": "node scripts/check-packaged-app-mobile.mjs",
    "test:mobile-readers": "node scripts/test-mobile-session-readers.mjs",
    "check:device-mobile": "node scripts/check-device-mobile.mjs",
    "test:dedupe-inject": "node scripts/test-dedupe-inject.js",
    "icons": "node scripts/gen-icons.js",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "preflight:mac": "node scripts/release-preflight.js",
    "release:mac": "node scripts/release-mac.js",
    "check:links": "node scripts/check-homepage-links.js",
    "check:runtime": "node scripts/dsh-runtime-version.js --check",
    "test:patch-selfheal": "node scripts/test-patch-selfheal.js",
    "test:office-row": "node scripts/test-office-row-heal.js",
    "test:readiness": "node scripts/test-service-readiness.js",
    "test:preset-heal": "node scripts/test-preset-heal.js",
    "test:pet": "npm run build && electron scripts/test-pet-actions.js",
    "dist:test": "npm run build && electron-builder --mac --config.directories.output=release-test",
    "check:cdn": "node scripts/check-cdn-artifacts.js",
    "manifest:rewrite": "node scripts/rewrite-update-manifest.js",
    "test:win-shortcut": "npm run build && node scripts/test-win-shortcut.js",
    "check:installer": "node scripts/check-installer-config.js",
    "check:shell-plugins": "node scripts/check-shell-plugins-shipped.js",
    "check:update-cancel": "node scripts/check-update-cancel.js",
    "check:skin-fullscreen": "node scripts/check-skin-fullscreen.js",
    "test:asar-copy": "node scripts/test-asar-copy.js",
    "check:asar": "node scripts/check-asar-packaging.js",
    "check:packaged-deps": "node scripts/check-packaged-deps.js release dist",
    "test:fault-log": "node scripts/test-fault-log.js",
    "check:release-notes": "node scripts/check-release-notes.js",
    "check:client-bundles": "node scripts/check-client-bundles.js",
    "check:office-preview": "node scripts/check-office-preview-packaged.js",
    "check:update-popup": "node scripts/check-update-popup-layout.js",
    "check:updater-differential": "node scripts/check-updater-differential.js",
    "check:installer-close": "node scripts/check-installer-close-app.js",
    "check:whatsnew-entry": "node scripts/check-whatsnew-entry.js",
    "smoke:isolated": "node scripts/smoke-isolated.js",
    "test:plugin-toolchain": "npm run build && node scripts/test-plugin-toolchain.js",
    "test:web-preview-overlay": "node scripts/test-web-preview-overlay.js",
    "test:model-label": "npm run build && node scripts/test-model-label.js",
    "test:sessions-legacy": "npm run build && node scripts/test-sessions-legacy.js",
    "check:release-consistency": "node scripts/check-release-consistency.js",
    "check:office-node": "node scripts/check-office-node-wrapper.js",
    "check:skin-theme": "node scripts/check-skin-theme-guard.js",
    "test:market": "npm run build && node scripts/test-plugin-market.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.1.0",
    "pnpm": "12.14.0",
    "qrcode-generator": "^2.0.4",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.3",
    "ws": "^8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/feely0208/deepwhale-desktop.git"
  },
  "homepage": "https://deepwhale.org.cn",
  "bugs": {
    "url": "https://github.com/feely0208/deepwhale-desktop/issues"
  }
}
