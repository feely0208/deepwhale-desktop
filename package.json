{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.0",
  "description": "跨平台桌面壳：把 DeepSeek Harness（DSH）Web UI 装进 Electron 原生窗口，附带皮肤系统、桌面宠物与用量/额度面板",
  "main": "dist/main/index.js",
  "author": "dsh-desktop contributors",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "electron",
    "desktop",
    "dsh"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "dev": "npm run build && electron .",
    "smoke": "npm run build && DSH_DESKTOP_SMOKE=1 electron .",
    "smoke:win": "npm run build && set DSH_DESKTOP_SMOKE=1&& electron .",
    "icons": "node scripts/gen-icons.js",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.3"
  }
}
