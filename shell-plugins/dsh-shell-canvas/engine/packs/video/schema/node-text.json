{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.deepwhale.org.cn/canvas/packs/video/node-text.schema.json",
  "title": "video / text 节点 props",
  "type": "object",
  "required": ["text", "font", "size"],
  "additionalProperties": false,
  "properties": {
    "text": { "type": "string", "maxLength": 2000 },
    "font": { "type": "string", "description": "字体 ID，必须命中领域包 fonts 白名单" },
    "size": { "type": "number", "exclusiveMinimum": 0, "maximum": 400 },
    "weight": { "enum": [300, 400, 500, 600, 700, 900] },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "align": { "enum": ["left", "center", "right"] },
    "lineHeight": { "type": "number", "exclusiveMinimum": 0.5, "maximum": 3 },
    "letterSpacing": { "type": "number", "minimum": -20, "maximum": 100 },
    "maxLines": { "type": "integer", "minimum": 1, "maximum": 20 },
    "outline": { "type": "number", "minimum": 0, "maximum": 20 },
    "shadow": { "type": "boolean" },
    "bgmId": { "type": "string", "description": "可选：该文字层配的背景音乐 ID，必须命中 bgm 台账" }
  }
}
