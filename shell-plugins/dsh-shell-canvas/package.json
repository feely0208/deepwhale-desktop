{
  "name": "@deepwhale-cn/dsh-shell-canvas",
  "version": "1.0.0",
  "description": "深鲸桌面：把深鲸画布（鲸幕）引擎做成侧边栏面板 —— 选模板、填参数、校验、预览、出横竖双版成片。渲染跑在独立子进程里（Chromium 或桌面端自带的 Electron OSR），界面不卡。",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "深鲸画布",
    "description": "旁白稿 + 素材 → 横竖双版成片；模板是数据，引擎是我们的。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime"],
      "platform": "web",
      "immediately": true
    }
  }
}
