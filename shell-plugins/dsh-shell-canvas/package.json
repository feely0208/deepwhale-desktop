{
  "name": "@deepwhale-cn/dsh-shell-canvas",
  "version": "1.0.6",
  "description": "把一段文字变成能发的视频。贴一段稿子、选几张素材，点一下出横竖双版成片；稿子、素材、成片都在你自己的电脑上，不上传、不联网。免费版即可用，授权后去水印。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "深鲸画布",
    "description": "旁白稿 + 素材 → 横竖双版成片；模板是数据，引擎是我们的。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh插件",
    "深鲸画布",
    "video",
    "text-to-video",
    "canvas",
    "whale",
    "deepwhale"
  ],
  "license": "UNLICENSED",
  "files": [
    "lib/",
    "engine/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ]
}
