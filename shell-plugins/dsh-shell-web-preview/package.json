{
  "name": "@deepwhale-cn/dsh-shell-web-preview",
  "version": "1.1.0",
  "description": "深鲸桌面：开启官方右栏「网页预览」，并在站点禁止内嵌时给出可操作的兜底提示（而不是一片空白）。",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "网页预览",
    "description": "打开官方右栏的沙箱化网页预览；遇到禁止内嵌的站点时提示「用浏览器打开」。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime"],
      "platform": "web",
      "immediately": true
    }
  }
}
